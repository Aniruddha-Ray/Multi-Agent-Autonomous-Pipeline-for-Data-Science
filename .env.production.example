# ============================================================
# PRODUCTION ENVIRONMENT — reference only. Copy to `.env` on
# your production host and fill in real values. Never commit
# the real `.env` file.
# ============================================================

# --- Application ---
ENVIRONMENT=production
APP_VERSION=1.2.0
LOG_LEVEL=INFO

# --- PostgreSQL ---
# In production, use a managed/secured Postgres instance, a strong
# generated password, and restrict network access to it.
POSTGRES_DB=pipeline_memory
POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_GENERATED_SECRET
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Groq LLM ---
GROQ_API_KEY=REPLACE_WITH_REAL_KEY

# --- FastAPI production hardening ---
# Real deployed frontend URL(s), comma-separated, no trailing slash.
ALLOWED_ORIGINS=https://your-streamlit-domain.example.com
# Real backend domain(s)/IP the API will be served from.
TRUSTED_HOSTS=your-backend-domain.example.com
REQUEST_TIMEOUT_SECONDS=600

# --- Streamlit -> Backend connectivity ---
# Public/internal URL the Streamlit container should call.
BACKEND_URL=https://your-backend-domain.example.com
